{
  "name": "sakura-kitchen-nuxt",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:init": "node --env-file=../.env.design-db.local scripts/design-db.mjs init",
    "db:import": "node --env-file=../.env.design-db.local scripts/design-db.mjs import",
    "test:design-db": "node --env-file=../.env.design-db.local scripts/check-design-db.mjs",
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare",
    "cms:init": "node --env-file=../.env.design-db.local --env-file=.env scripts/cms-db.mjs init",
    "cms:seed": "node --env-file=.env scripts/cms-db.mjs seed",
    "cms:assets": "node --env-file=.env scripts/cms-assets.mjs",
    "cms:admin": "node --env-file=.env scripts/cms-db.mjs create-admin",
    "cms:reset": "node --env-file=.env scripts/cms-db.mjs reset-password",
    "cms:backup": "node --env-file=.env scripts/cms-db.mjs backup",
    "cms:restore": "node --env-file=../.env.design-db.local --env-file=.env scripts/cms-db.mjs restore",
    "test:cms": "node --env-file=.env scripts/check-cms.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "embla-carousel-vue": "^8.6.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lucide-vue-next": "^0.487.0",
    "mssql": "^12.7.2",
    "nuxt": "3.21.10",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.2.1",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "typescript": "^5.8.0",
    "vite": "7.3.6",
    "vue-tsc": "^2.2.0"
  }
}
